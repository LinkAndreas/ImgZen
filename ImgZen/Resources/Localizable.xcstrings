    "support.imgZenIsFree" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen ist kostenlos, ohne Werbung und mit allen Funktionen. Wenn dir die App nützt, kannst du ihre Pflege und die Entwicklung neuer Funktionen unterstützen – als Dankeschön gibt es für regelmäßige Unterstützung eigene App-Icons."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen is free, with no ads and every feature included. If it’s useful to you, you can support its maintenance and the development of new features — recurring supporters get a set of app icons as a thank-you."
          }
        }
      }
    },
