    "versionHistory.v1_9_0.note3" : {
      "comment" : "Version history: release note 3 of version 1.9.0, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen spricht jetzt neben Deutsch und Englisch auch Spanisch, Französisch, Italienisch, Portugiesisch (Brasilien), Niederländisch, Japanisch, Koreanisch, Chinesisch (vereinfacht) und Russisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen now speaks Spanish, French, Italian, Portuguese (Brazil), Dutch, Japanese, Korean, Chinese (Simplified) and Russian, alongside English and German."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Además de inglés y alemán, ImgZen ahora habla español, francés, italiano, portugués (Brasil), neerlandés, japonés, coreano, chino (simplificado) y ruso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En plus de l’anglais et de l’allemand, ImgZen parle désormais espagnol, français, italien, portugais (Brésil), néerlandais, japonais, coréen, chinois (simplifié) et russe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oltre a inglese e tedesco, ImgZen ora parla spagnolo, francese, italiano, portoghese (Brasile), olandese, giapponese, coreano, cinese (semplificato) e russo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英語とドイツ語に加えて、スペイン語、フランス語、イタリア語、ポルトガル語（ブラジル）、オランダ語、日本語、韓国語、中国語（簡体字）、ロシア語に対応しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 영어와 독일어 외에도 스페인어, 프랑스어, 이탈리아어, 포르투갈어(브라질), 네덜란드어, 일본어, 한국어, 중국어(간체), 러시아어를 지원해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naast Engels en Duits spreekt ImgZen nu ook Spaans, Frans, Italiaans, Portugees (Brazilië), Nederlands, Japans, Koreaans, Chinees (vereenvoudigd) en Russisch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Além de inglês e alemão, o ImgZen agora fala espanhol, francês, italiano, português (Brasil), holandês, japonês, coreano, chinês (simplificado) e russo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помимо английского и немецкого, ImgZen теперь говорит на испанском, французском, итальянском, португальском (Бразилия), нидерландском, японском, корейском, китайском (упрощённом) и русском."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除英语和德语外，ImgZen 现已支持西班牙语、法语、意大利语、葡萄牙语（巴西）、荷兰语、日语、韩语、简体中文和俄语。"
          }
