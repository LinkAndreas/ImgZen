    "versionHistory.v1_0_0.note1" : {
      "comment" : "Version history: release note 1 of version 1.0.0, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen erscheint im App Store: Bilder zwischen PNG, JPEG, TIFF, BMP, HEIC und WebP konvertieren, verlustfrei oder verlustbehaftet mit einstellbarer Qualität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen arrives on the App Store: convert images between PNG, JPEG, TIFF, BMP, HEIC and WebP, lossless or lossy with adjustable quality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen llega al App Store: convierte imágenes entre PNG, JPEG, TIFF, BMP, HEIC y WebP, sin pérdida o con pérdida y calidad ajustable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen arrive sur l’App Store : convertis des images entre PNG, JPEG, TIFF, BMP, HEIC et WebP, sans perte ou avec perte et une qualité réglable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen arriva su App Store: converti le immagini tra PNG, JPEG, TIFF, BMP, HEIC e WebP, senza perdita o con perdita e qualità regolabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZenがApp Storeに登場：PNG、JPEG、TIFF、BMP、HEIC、WebPの間で画像を変換できます。可逆圧縮のほか、画質を調整できる非可逆圧縮にも対応しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen이 App Store에 출시되었어요. PNG, JPEG, TIFF, BMP, HEIC, WebP 간에 이미지를 무손실로, 또는 품질을 조절할 수 있는 손실 압축으로 변환하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen verschijnt in de App Store: converteer afbeeldingen tussen PNG, JPEG, TIFF, BMP, HEIC en WebP, verliesvrij of met verlies en met instelbare kwaliteit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ImgZen chega à App Store: converta imagens entre PNG, JPEG, TIFF, BMP, HEIC e WebP, sem perda ou com perda e qualidade ajustável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen появляется в App Store: конвертируй изображения между PNG, JPEG, TIFF, BMP, HEIC и WebP — без потерь или с потерями и настраиваемым качеством."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen 登陆 App Store：在 PNG、JPEG、TIFF、BMP、HEIC 和 WebP 之间转换图片，可选择无损或有损，质量可调。"
          }
        }
      }
    },
    "versionHistory.v1_0_0.note2" : {
      "comment" : "Version history: release note 2 of version 1.0.0, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viele Bilder auf einmal konvertieren, mit Fortschrittsanzeige, aus Fotos oder Dateien importieren und die Ergebnisse direkt aus der App teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convert many images at once with progress tracking, import from Photos or Files, and share the results straight from the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte muchas imágenes a la vez viendo el progreso, impórtalas desde Fotos o Archivos y comparte los resultados directamente desde la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convertis de nombreuses images à la fois avec suivi de la progression, importe-les depuis Photos ou Fichiers et partage les résultats directement depuis l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converti molte immagini insieme seguendone l’avanzamento, importale da Foto o File e condividi i risultati direttamente dall’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進行状況を確認しながら多数の画像をまとめて変換。「写真」や「ファイル」から読み込み、変換結果をAppから直接共有できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 상황을 확인하며 여러 이미지를 한 번에 변환하고, 사진이나 파일에서 가져오고, 결과를 앱에서 바로 공유하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converteer veel afbeeldingen tegelijk met voortgangsweergave, importeer uit Foto’s of Bestanden en deel de resultaten rechtstreeks vanuit de app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converta várias imagens de uma vez acompanhando o progresso, importe de Fotos ou Arquivos e compartilhe os resultados direto do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конвертируй много изображений сразу с отображением прогресса, импортируй их из «Фото» или «Файлов» и делись результатами прямо из приложения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次转换多张图片并显示进度，从“照片”或“文件”导入，并直接在 App 中分享结果。"
          }
        }
      }
    },
    "versionHistory.v1_0_0.note3" : {
      "comment" : "Version history: release note 3 of version 1.0.0, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles geschieht auf deinem Gerät: keine Datensammlung und kein Zugriff auf deine gesamte Fotomediathek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything happens on your device: no data collection and no access to your full photo library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo ocurre en tu dispositivo: sin recopilación de datos y sin acceso a toda tu fototeca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout se passe sur ton appareil : aucune collecte de données et aucun accès à l’ensemble de ta photothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto avviene sul tuo dispositivo: nessuna raccolta di dati e nessun accesso all’intera libreria foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての処理はデバイス上で行われます。データの収集はなく、フォトライブラリ全体へのアクセスもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 작업은 기기에서 이루어져요. 데이터를 수집하지 않으며 전체 사진 보관함에 접근하지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles gebeurt op je apparaat: geen gegevensverzameling en geen toegang tot je volledige fotobibliotheek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo acontece no seu dispositivo: nenhuma coleta de dados e nenhum acesso à sua fototeca inteira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё происходит на твоём устройстве: никакого сбора данных и никакого доступа ко всей твоей медиатеке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都在你的设备上完成：不收集数据，也不访问你的整个照片图库。"
          }
        }
      }
    },
    "versionHistory.v1_7_10.note1" : {
      "comment" : "Version history: release note 1 of version 1.7.10, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neues App-Icon – und die App übernimmt seine Akzentfarbe und seinen Hintergrund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
