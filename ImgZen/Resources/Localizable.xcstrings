    "versionHistory.v1_9_0.note1" : {
      "comment" : "Version history: release note 1 of version 1.9.0, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zahnrad (mit Tastatur auch ⌘,) öffnet die neuen Einstellungen – App-Icon, Feedback, rechtliche Seiten und Open-Source-Lizenzen an einem Ort statt im ⋯-Menü."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The gear button (or ⌘, on a keyboard) opens the new Settings — the app icon, feedback, the legal pages and the open-source licenses, all in one place instead of the ⋯ menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón del engranaje (o ⌘, con un teclado) abre los nuevos Ajustes: el icono de la app, los comentarios, las páginas legales y las licencias de código abierto, todo en un solo lugar en vez del menú ⋯."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton en forme d’engrenage (ou ⌘, sur un clavier) ouvre les nouveaux Réglages : l’icône de l’app, ton avis, les pages juridiques et les licences open source, tout au même endroit au lieu du menu ⋯."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pulsante con l’ingranaggio (o ⌘, con una tastiera) apre le nuove Impostazioni: icona dell’app, feedback, pagine legali e licenze open source, tutto in un unico posto invece che nel menu ⋯."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歯車ボタン（キーボードでは⌘,）で新しい設定が開きます。Appアイコン、フィードバック、法的情報、オープンソースライセンスを、「⋯」メニューの代わりに1か所にまとめました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "톱니바퀴 버튼(키보드에서는 ⌘,)을 누르면 새로운 설정이 열려요. 앱 아이콘, 피드백, 법적 정보, 오픈 소스 라이선스를 ⋯ 메뉴 대신 한곳에 모았어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tandwielknop (of ⌘, op een toetsenbord) opent de nieuwe Instellingen – het appsymbool, feedback, de juridische pagina’s en de opensourcelicenties, alles op één plek in plaats van in het ⋯-menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O botão de engrenagem (ou ⌘, no teclado) abre os novos Ajustes — o ícone do app, o feedback, as páginas legais e as licenças de código aberto, tudo num só lugar em vez do menu ⋯."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка с шестерёнкой (или ⌘, на клавиатуре) открывает новые Настройки — значок приложения, отзывы, юридические страницы и лицензии открытого ПО в одном месте вместо меню ⋯."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "齿轮按钮（或键盘上的 ⌘,）可打开全新的设置：App 图标、反馈、法律页面和开源许可证集中于一处，取代了 ⋯ 菜单。"
          }
        }
      }
    },
    "versionHistory.v1_9_0.note2" : {
