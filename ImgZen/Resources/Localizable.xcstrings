    "versionHistory.v1_8_1.note1" : {
      "comment" : "Version history: release note 1 of version 1.8.1, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine In-App-Käufe und keine Abos mehr – alle Funktionen und alle App-Icons sind für alle frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No more in-app purchases or subscriptions — every feature and every app icon is free for everyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin compras dentro de la app ni suscripciones: todas las funciones y todos los iconos de la app son gratis para todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fini les achats intégrés et les abonnements : toutes les fonctions et toutes les icônes de l’app sont gratuites pour tous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente più acquisti in-app né abbonamenti – ogni funzione e ogni icona dell’app sono gratuite per tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App内課金やサブスクリプションはなくなりました。すべての機能とすべてのAppアイコンを、誰でも無料で使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 내 구입과 구독이 모두 없어졌어요. 모든 기능과 모든 앱 아이콘을 누구나 무료로 사용할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen in-app-aankopen of abonnementen meer – elke functie en elk appsymbool is gratis voor iedereen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem compras dentro do app nem assinaturas — todos os recursos e todos os ícones do app são gratuitos para todos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше никаких встроенных покупок и подписок — все функции и все значки приложения бесплатны для всех."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不再有 App 内购买或订阅——所有功能和所有 App 图标对所有人免费。"
          }
        }
      }
    },
    "versionHistory.v1_8_1.note2" : {
      "comment" : "Version history: release note 2 of version 1.8.1, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle unter ⋯ › App-Icon eines der acht Icons; die App übernimmt die Farben des gewählten Icons."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose one of eight icons under ⋯ › App Icon; the app takes on the colors of the icon you pick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige uno de los ocho iconos en ⋯ › Icono de la app; la app adopta los colores del icono que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis l’une des huit icônes dans ⋯ › Icône de l’app ; l’app adopte les couleurs de l’icône choisie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una delle otto icone in ⋯ › Icona app; l’app assume i colori dell’icona che scegli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「⋯」›「Appアイコン」で8種類のアイコンから選択できます。Appは選んだアイコンの色に合わせて変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⋯ › 앱 아이콘에서 8가지 아이콘 중 하나를 선택하세요. 앱이 선택한 아이콘의 색상으로 바뀌어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een van de acht symbolen via ⋯ › Appsymbool; de app neemt de kleuren aan van het symbool dat je kiest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um dos oito ícones em ⋯ › Ícone do app; o app assume as cores do ícone escolhido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбери один из восьми значков в ⋯ › Значок приложения; приложение перенимает цвета выбранного значка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“⋯ › App 图标”中从八款图标中任选其一；App 会采用所选图标的配色。"
          }
        }
      }
    },
