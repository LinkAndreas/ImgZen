    "settings.feedback.footer" : {
      "comment" : "Footer of the feedback section in the settings.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen ist kostenlos. Eine Bewertung oder ein paar Worte helfen, es bekannter und besser zu machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
