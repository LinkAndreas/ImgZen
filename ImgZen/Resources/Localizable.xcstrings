    "whatsNew.settings.text" : {
      "comment" : "What's New: description of the new Settings screen. ⌘, is the keyboard shortcut; ⋯ is the menu that was removed.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp aufs Zahnrad oder drück ⌘, auf der Tastatur, um das App-Icon zu wählen, ImgZen zu bewerten, Feedback zu senden und die rechtlichen Seiten und Open-Source-Lizenzen zu finden. Das ⋯-Menü gibt es nicht mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the gear button, or press ⌘, on a keyboard, to choose the app icon, rate ImgZen, send feedback, and find the legal pages and open-source licenses. The ⋯ menu is gone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el engranaje, o pulsa ⌘, en un teclado, para elegir el icono de la app, valorar ImgZen, enviar comentarios y encontrar las páginas legales y las licencias de código abierto. El menú ⋯ ya no existe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche l’engrenage, ou appuie sur ⌘, sur un clavier, pour choisir l’icône de l’app, noter ImgZen, envoyer un commentaire et trouver les pages juridiques et les licences open source. Le menu ⋯ n’existe plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca l’ingranaggio, o premi ⌘, su una tastiera, per scegliere l’icona dell’app, valutare ImgZen, inviare feedback e trovare le pagine legali e le licenze open source. Il menu ⋯ non c’è più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歯車をタップするか、キーボードで⌘,を押すと、Appアイコンの選択、ImgZenの評価、フィードバックの送信ができ、法的情報やオープンソースライセンスも確認できます。「⋯」メニューはなくなりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "톱니바퀴를 탭하거나 키보드에서 ⌘,을 누르면 앱 아이콘을 선택하고, ImgZen을 평가하고, 피드백을 보내고, 법적 정보와 오픈 소스 라이선스를 확인할 수 있어요. ⋯ 메뉴는 없어졌어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op het tandwiel, of druk op ⌘, op een toetsenbord, om het appsymbool te kiezen, ImgZen te beoordelen, feedback te sturen en de juridische pagina’s en opensourcelicenties te vinden. Het ⋯-menu is verdwenen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque na engrenagem, ou pressione ⌘, no teclado, para escolher o ícone do app, avaliar o ImgZen, enviar feedback e encontrar as páginas legais e as licenças de código aberto. O menu ⋯ não existe mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажми на шестерёнку или ⌘, на клавиатуре, чтобы выбрать значок приложения, оценить ImgZen, отправить отзыв и найти юридические страницы и лицензии открытого ПО. Меню ⋯ больше нет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点齿轮按钮，或在键盘上按 ⌘,，即可选择 App 图标、为 ImgZen 评分、发送反馈，并查看法律页面和开源许可证。⋯ 菜单已移除。"
          }
        }
      }
