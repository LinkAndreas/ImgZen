    "whatsNew.languages.text" : {
      "comment" : "What's New: description of the new languages. \"Settings app\" is the system Settings app, where a language can be picked for ImgZen alone.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neben Deutsch und Englisch spricht ImgZen jetzt auch Spanisch, Französisch, Italienisch, Portugiesisch (Brasilien), Niederländisch, Japanisch, Koreanisch, Chinesisch (vereinfacht) und Russisch. Die App folgt der Sprache deines Geräts – oder du wählst in der Einstellungen-App eine nur für ImgZen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besides English and German, ImgZen now speaks Spanish, French, Italian, Portuguese (Brazil), Dutch, Japanese, Korean, Chinese (Simplified) and Russian. It follows your device’s language, or pick one just for ImgZen in the Settings app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Además de inglés y alemán, ImgZen ahora habla español, francés, italiano, portugués (Brasil), neerlandés, japonés, coreano, chino (simplificado) y ruso. Usa el idioma de tu dispositivo, o elige uno solo para ImgZen en la app Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En plus de l’anglais et de l’allemand, ImgZen parle désormais espagnol, français, italien, portugais (Brésil), néerlandais, japonais, coréen, chinois (simplifié) et russe. L’app suit la langue de ton appareil, ou choisis-en une rien que pour ImgZen dans l’app Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oltre a inglese e tedesco, ImgZen ora parla spagnolo, francese, italiano, portoghese (Brasile), olandese, giapponese, coreano, cinese (semplificato) e russo. Usa la lingua del tuo dispositivo, oppure scegline una solo per ImgZen nell’app Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英語とドイツ語に加えて、スペイン語、フランス語、イタリア語、ポルトガル語（ブラジル）、オランダ語、日本語、韓国語、中国語（簡体字）、ロシア語に対応しました。デバイスの言語に合わせて表示されますが、「設定」AppでImgZenだけの言語を選ぶこともできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 영어와 독일어 외에도 스페인어, 프랑스어, 이탈리아어, 포르투갈어(브라질), 네덜란드어, 일본어, 한국어, 중국어(간체), 러시아어를 지원해요. 기기 언어를 따르지만, 설정 앱에서 ImgZen에만 쓸 언어를 고를 수도 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naast Engels en Duits spreekt ImgZen nu ook Spaans, Frans, Italiaans, Portugees (Brazilië), Nederlands, Japans, Koreaans, Chinees (vereenvoudigd) en Russisch. De app volgt de taal van je apparaat, of kies in de app Instellingen een taal alleen voor ImgZen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Além de inglês e alemão, o ImgZen agora fala espanhol, francês, italiano, português (Brasil), holandês, japonês, coreano, chinês (simplificado) e russo. Ele segue o idioma do seu dispositivo, ou escolha um só para o ImgZen no app Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помимо английского и немецкого, ImgZen теперь говорит на испанском, французском, итальянском, португальском (Бразилия), нидерландском, японском, корейском, китайском (упрощённом) и русском. Приложение следует языку устройства, но в приложении «Настройки» можно выбрать язык только для ImgZen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除英语和德语外，ImgZen 现已支持西班牙语、法语、意大利语、葡萄牙语（巴西）、荷兰语、日语、韩语、简体中文和俄语。App 会跟随设备语言，你也可以在“设置”App 中单独为 ImgZen 选择语言。"
          }
        }
      }
    },
