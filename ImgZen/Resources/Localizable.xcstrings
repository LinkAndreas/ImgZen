          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad에서 이미지를 드래그 앤 드롭하여 ImgZen에 넣을 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
