          }
        }
      }
    },
    "versionHistory.v1_7_10.note7" : {
      "comment" : "Version history: release note 7 of version 1.7.10, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder per Drag & Drop auf dem iPad in ImgZen ziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
