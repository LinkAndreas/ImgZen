        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 앱 아이콘이 생겼고, 앱의 강조 색상과 배경도 이 아이콘에 맞춰져요."
          }
        },
        "nl" : {
          "stringUnit" : {
