    "versionHistory.v1_0_0.note1" : {
      "comment" : "Version history: release note 1 of version 1.0.0, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen erscheint im App Store: Bilder zwischen PNG, JPEG, TIFF, BMP, HEIC und WebP konvertieren, verlustfrei oder verlustbehaftet mit einstellbarer Qualität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen arrives on the App Store: convert images between PNG, JPEG, TIFF, BMP, HEIC and WebP, lossless or lossy with adjustable quality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen llega al App Store: convierte imágenes entre PNG, JPEG, TIFF, BMP, HEIC y WebP, sin pérdida o con pérdida y calidad ajustable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen arrive sur l’App Store : convertis des images entre PNG, JPEG, TIFF, BMP, HEIC et WebP, sans perte ou avec perte et une qualité réglable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen arriva su App Store: converti le immagini tra PNG, JPEG, TIFF, BMP, HEIC e WebP, senza perdita o con perdita e qualità regolabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZenがApp Storeに登場：PNG、JPEG、TIFF、BMP、HEIC、WebPの間で画像を変換できます。可逆圧縮のほか、画質を調整できる非可逆圧縮にも対応しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen이 App Store에 출시되었어요. PNG, JPEG, TIFF, BMP, HEIC, WebP 간에 이미지를 무손실로, 또는 품질을 조절할 수 있는 손실 압축으로 변환하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen verschijnt in de App Store: converteer afbeeldingen tussen PNG, JPEG, TIFF, BMP, HEIC en WebP, verliesvrij of met verlies en met instelbare kwaliteit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ImgZen chega à App Store: converta imagens entre PNG, JPEG, TIFF, BMP, HEIC e WebP, sem perda ou com perda e qualidade ajustável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen появляется в App Store: конвертируй изображения между PNG, JPEG, TIFF, BMP, HEIC и WebP — без потерь или с потерями и настраиваемым качеством."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ImgZen 登陆 App Store：在 PNG、JPEG、TIFF、BMP、HEIC 和 WebP 之间转换图片，可选择无损或有损，质量可调。"
          }
        }
      }
    },
    "versionHistory.v1_0_0.note2" : {
      "comment" : "Version history: release note 2 of version 1.0.0, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viele Bilder auf einmal konvertieren, mit Fortschrittsanzeige, aus Fotos oder Dateien importieren und die Ergebnisse direkt aus der App teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convert many images at once with progress tracking, import from Photos or Files, and share the results straight from the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte muchas imágenes a la vez viendo el progreso, impórtalas desde Fotos o Archivos y comparte los resultados directamente desde la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convertis de nombreuses images à la fois avec suivi de la progression, importe-les depuis Photos ou Fichiers et partage les résultats directement depuis l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converti molte immagini insieme seguendone l’avanzamento, importale da Foto o File e condividi i risultati direttamente dall’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進行状況を確認しながら多数の画像をまとめて変換。「写真」や「ファイル」から読み込み、変換結果をAppから直接共有できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 상황을 확인하며 여러 이미지를 한 번에 변환하고, 사진이나 파일에서 가져오고, 결과를 앱에서 바로 공유하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converteer veel afbeeldingen tegelijk met voortgangsweergave, importeer uit Foto’s of Bestanden en deel de resultaten rechtstreeks vanuit de app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converta várias imagens de uma vez acompanhando o progresso, importe de Fotos ou Arquivos e compartilhe os resultados direto do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конвертируй много изображений сразу с отображением прогресса, импортируй их из «Фото» или «Файлов» и делись результатами прямо из приложения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次转换多张图片并显示进度，从“照片”或“文件”导入，并直接在 App 中分享结果。"
          }
        }
      }
    },
    "versionHistory.v1_0_0.note3" : {
      "comment" : "Version history: release note 3 of version 1.0.0, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles geschieht auf deinem Gerät: keine Datensammlung und kein Zugriff auf deine gesamte Fotomediathek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything happens on your device: no data collection and no access to your full photo library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo ocurre en tu dispositivo: sin recopilación de datos y sin acceso a toda tu fototeca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout se passe sur ton appareil : aucune collecte de données et aucun accès à l’ensemble de ta photothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto avviene sul tuo dispositivo: nessuna raccolta di dati e nessun accesso all’intera libreria foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての処理はデバイス上で行われます。データの収集はなく、フォトライブラリ全体へのアクセスもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 작업은 기기에서 이루어져요. 데이터를 수집하지 않으며 전체 사진 보관함에 접근하지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles gebeurt op je apparaat: geen gegevensverzameling en geen toegang tot je volledige fotobibliotheek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo acontece no seu dispositivo: nenhuma coleta de dados e nenhum acesso à sua fototeca inteira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё происходит на твоём устройстве: никакого сбора данных и никакого доступа ко всей твоей медиатеке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都在你的设备上完成：不收集数据，也不访问你的整个照片图库。"
          }
        }
      }
    },
    "versionHistory.v1_7_10.note1" : {
      "comment" : "Version history: release note 1 of version 1.7.10, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neues App-Icon – und die App übernimmt seine Akzentfarbe und seinen Hintergrund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new app icon, and the app takes its accent color and background from it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nuevo icono de la app, del que la app toma su color de acento y su fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nouvelle icône d’app, dont l’app reprend la couleur d’accentuation et l’arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nuova icona dell’app, da cui l’app prende il colore principale e lo sfondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいAppアイコン。Appのアクセントカラーと背景もアイコンに合わせて変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 앱 아이콘이 생겼고, 앱의 강조 색상과 배경도 이 아이콘에 맞춰져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een nieuw appsymbool, en de app neemt er zijn accentkleur en achtergrond van over."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um novo ícone do app, que agora define a cor de destaque e o fundo do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый значок приложения — и приложение берёт из него акцентный цвет и фон."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全新的 App 图标，App 的强调色和背景也取自图标。"
          }
        }
      }
    },
    "versionHistory.v1_7_10.note2" : {
      "comment" : "Version history: release note 2 of version 1.7.10, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ergebnisse öffnen sich in einem Fenster über deinen Bildern – ansehen, gewünschte auswählen und teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Results open in a sheet over your images — review them, choose the ones you want, and share."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los resultados se abren en una hoja sobre tus imágenes: revísalos, elige los que quieras y compártelos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les résultats s’ouvrent dans une fenêtre par-dessus tes images : vérifie-les, choisis celles que tu veux et partage-les."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I risultati si aprono in un pannello sopra le tue immagini – controllali, scegli quelli che vuoi e condividili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変換結果は画像の上にシートで表示されます。確認して、必要な画像を選び、共有できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변환 결과가 이미지 위의 시트로 열려요. 결과를 확인하고 원하는 이미지를 선택해 공유하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De resultaten openen in een venster boven je afbeeldingen – bekijk ze, kies de afbeeldingen die je wilt en deel ze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os resultados abrem em um painel sobre suas imagens — revise-os, escolha os que quiser e compartilhe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Результаты открываются в окне поверх твоих изображений — просмотри их, выбери нужные и поделись."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转换结果会在图片上方的面板中打开——查看结果，选择需要的图片，然后分享。"
          }
        }
      }
    },
    "versionHistory.v1_7_10.note3" : {
      "comment" : "Version history: release note 3 of version 1.7.10, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vier klare Qualitätsstufen und zu jedem Format und jeder Stufe ein kurzer Hinweis, wofür sie sich eignen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Four clear quality levels, with a short note on what each format and level is best for."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuatro niveles de calidad claros, con una breve nota sobre para qué es ideal cada formato y cada nivel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quatre niveaux de qualité clairs, avec une courte note indiquant à quoi convient chaque format et chaque niveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quattro livelli di qualità chiari e, per ogni formato e livello, una breve nota sull’uso per cui è più adatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "わかりやすい4段階の画質。各形式と各段階が何に適しているかを短く説明します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명확한 4단계 품질 수준을 제공하며, 각 포맷과 수준이 어디에 가장 적합한지 짧게 알려 줘요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vier duidelijke kwaliteitsniveaus, met bij elk formaat en elk niveau een korte uitleg waarvoor het het meest geschikt is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quatro níveis de qualidade claros, com uma breve nota sobre para que serve cada formato e nível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Четыре понятных уровня качества и короткая подсказка, для чего лучше всего подходит каждый формат и уровень."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "四个清晰的质量等级，并为每种格式和等级附上简短说明，告诉你最适合的用途。"
          }
        }
      }
    },
    "versionHistory.v1_7_10.note4" : {
      "comment" : "Version history: release note 4 of version 1.7.10, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem iPad bleibt das Zielformat neben deinen Bildern, und „Konvertieren“ funktioniert mit ⌘ Return."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On iPad, the output format stays beside your images, and Convert works with ⌘ Return."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el iPad, el formato de salida se queda junto a tus imágenes, y «Convertir» funciona con ⌘ Retorno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur iPad, le format de sortie reste à côté de tes images, et « Convertir » fonctionne avec ⌘ Return."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su iPad il formato di uscita resta accanto alle tue immagini e “Converti” funziona con ⌘ Return."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPadでは出力形式が画像の横に表示されたままになり、⌘ Returnで「変換」を実行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad에서는 출력 포맷이 이미지 옆에 계속 표시되며, ⌘ Return으로 ‘변환’을 실행할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op iPad blijft het uitvoerformaat naast je afbeeldingen staan, en ‘Converteer’ werkt met ⌘ Return."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No iPad, o formato de saída fica ao lado das suas imagens, e “Converter” funciona com ⌘ Return."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На iPad выходной формат остаётся рядом с твоими изображениями, а «Конвертировать» работает с ⌘ Return."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPad 上，输出格式始终显示在图片旁边，并可使用 ⌘ Return 进行“转换”。"
          }
        }
      }
    },
    "versionHistory.v1_7_10.note5" : {
      "comment" : "Version history: release note 5 of version 1.7.10, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Alle entfernen“ leert die Liste mit einem Tipp; deine Originale bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear All empties the list in one tap; your originals stay untouched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Quitar todo» vacía la lista con un toque; tus originales no se modifican."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Tout effacer » vide la liste d’un seul toucher ; tes originaux restent intacts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Rimuovi tutto” svuota l’elenco con un tocco; i tuoi originali restano intatti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「すべて消去」でリストをワンタップで空にできます。オリジナルはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘모두 지우기’를 한 번 탭하면 목록이 비워져요. 원본은 그대로 유지돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Wis alles’ maakt de lijst in één tik leeg; je originelen blijven onaangeroerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Limpar tudo” esvazia a lista com um toque; seus originais continuam intactos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Очистить всё» очищает список одним касанием; твои оригиналы остаются нетронутыми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“全部清除”只需轻点一下即可清空列表；你的原始图片不会受到影响。"
          }
        }
      }
    },
    "versionHistory.v1_7_10.note6" : {
      "comment" : "Version history: release note 6 of version 1.7.10, shown as a bullet point.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine klarere Fortschrittsanzeige, die bestätigt, wenn alle Bilder konvertiert sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A clearer progress card that confirms when every image is converted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tarjeta de progreso más clara que confirma cuando todas las imágenes están convertidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une carte de progression plus claire, qui confirme quand toutes les images sont converties."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una scheda di avanzamento più chiara, che conferma quando tutte le immagini sono state convertite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "わかりやすくなった進行状況カード。すべての画像の変換が終わるとお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 이미지의 변환이 끝나면 이를 알려 주는, 더 명확해진 진행 상황 카드."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een duidelijkere voortgangskaart die bevestigt wanneer alle afbeeldingen zijn geconverteerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
