          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более понятная карточка прогресса, которая подтверждает, когда все изображения конвертированы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
